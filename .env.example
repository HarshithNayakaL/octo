# Server only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
DEFAULT_PROVIDER=google
GEMINI_API_KEY=
GEMINI_AGENT=antigravity-preview-09-2026
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
# Optional bearer token required for all API routes when configured.
# Required when binding to a non-loopback interface.
APP_TOKEN=
HOST=127.0.0.1
# Optional CRM MCP: configure a real HTTPS endpoint and narrow tool allowlist.
CRM_MCP_URL=
CRM_MCP_TOKEN=
CRM_MCP_ALLOWED_TOOLS=
# Vercel deployments only: Postgres connection (added by the Neon integration)
# and an optional secret for the scheduled backstop at /api/cron/tick.
DATABASE_URL=
CRON_SECRET=
