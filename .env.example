# Server only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# OpenAI is locked in the UI until this word is entered. Empty = cannot be unlocked.
OPENAI_UNLOCK_WORD=
DEFAULT_PROVIDER=google
GEMINI_API_KEY=
GEMINI_AGENT=antigravity-preview-09-2026
GEMINI_MODEL=gemini-3.8-flash
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATA_DIR=./data
# Optional bearer token for all API routes. Required when binding to a
# non-loopback interface locally; optional on Vercel.
APP_TOKEN=
HOST=127.0.0.1
# Optional CRM MCP: configure a real HTTPS endpoint and narrow tool allowlist.
CRM_MCP_URL=
CRM_MCP_TOKEN=
CRM_MCP_ALLOWED_TOOLS=
# Vercel only: DATABASE_URL is added automatically by the Neon integration.
# CRON_SECRET is optional and enables the /api/cron/tick backstop.
DATABASE_URL=
CRON_SECRET=
